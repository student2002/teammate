# ==============================================================
# Teammate 环境变量示例 — 复制为 .env 并填入真实值
# ==============================================================
# cp product/.env.example product/.env
#
# ⚠️  生产部署必填项（缺失则容器启动失败）：
#   TEAMS_DB_PASS, TEAMS_JWT_SECRET, TEAMMATE_ENCRYPTION_KEY_BASE64, TEAMS_ALLOWED_ORIGINS
# ==============================================================

# ---- 数据库密码（必填） ----
# 生成：openssl rand -hex 16
TEAMS_DB_PASS=CHANGE_ME_TO_RANDOM_PASSWORD

# ---- 生产密钥（必填） ----
# 生成：openssl rand -hex 32
TEAMS_JWT_SECRET=CHANGE_ME_TO_RANDOM_HEX_STRING

# 生成：openssl rand 32 | base64 -w0
TEAMMATE_ENCRYPTION_KEY_BASE64=CHANGE_ME_TO_32BYTE_BASE64_KEY

# ---- CORS（必填） ----
# 生产环境禁止通配符 *，必须指定前端域名
# 多个域名用逗号分隔，例如：https://app.example.com,https://www.example.com
TEAMS_ALLOWED_ORIGINS=https://your-domain.com

# ---- 前端 API 地址（必填，Docker Compose 部署时） ----
# 容器间通信使用服务名，例如 http://app:8080
# 如果前端和 API 在同一台机器但不同容器，使用服务名
# 如果前端独立部署，使用 API 的公网地址
NEXT_PUBLIC_API_BASE_URL=http://app:8080

# ---- 前端 WebSocket 地址（生产必填） ----
# 任务实时日志（WebSocket）地址，生产需 wss:// 前缀，指向后端 /api 同源或直连
# NEXT_PUBLIC_WS_URL=wss://api.your-domain.com

# ---- 前端端口（可选） ----
# WEB_PORT=3000

# ---- 基础 URL（必填，OAuth 回调需要） ----
# 生产环境必须改为实际域名
TEAMS_BASE_URL=http://localhost:8080

# ---- 国内镜像加速（可选） ----
# Docker 镜像仓库前缀（末尾必须带 /）
# DOCKER_REGISTRY=docker.m.daocloud.io/
# Go 模块代理
# GOPROXY=https://goproxy.cn,direct
# Alpine apk 镜像
# ALPINE_REPO=mirrors.aliyun.com
# NPM 镜像
# NPM_REGISTRY=https://registry.npmmirror.com

# ---- 服务端口（可选） ----
# TEAMS_PORT=8080

# ---- 数据库连接（可选，以下为 Docker Compose 默认值） ----
# TEAMS_DATABASE_URL=postgres://postgres:teammate@postgres:5432/teammate?sslmode=disable
# TEAMS_REDIS_URL=redis://redis:6379/0

# ---- OAuth（可选） ----
# TEAMS_GITHUB_CLIENT_ID=
# TEAMS_GITHUB_SECRET=
# TEAMS_GOOGLE_CLIENT_ID=
# TEAMS_GOOGLE_SECRET=

# ---- 超时（可选） ----
# TEAMS_READ_TIMEOUT=15s
# TEAMS_WRITE_TIMEOUT=60s
# TEAMS_MAX_BODY_SIZE=10485760
